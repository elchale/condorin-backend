# Django
DJANGO_SECRET_KEY=
DEBUG=False
DOMAIN=api.condorin.pe
# Where the expediente pages live (the WhatsApp button opens FRONTEND_URL/expediente/<token>).
FRONTEND_URL=https://condorin.pe
# Extra browser origins allowed to call the API, comma separated (e.g. http://localhost:3000).
ADDITIONAL_CORS_ORIGINS=

# Neon Postgres (pooled URL). Leave empty locally to use SQLite.
DATABASE_URL=

# Detector webhook. Accepts either credential; empty disables that side.
DETECTIONS_SHARED_SECRET=
DETECTIONS_OIDC_AUDIENCE=https://api.condorin.pe/api/v1/detections
# Service accounts allowed to mint the Google ID token, comma separated.
DETECTIONS_ALLOWED_SERVICE_ACCOUNTS=
ALERT_MIN_CONFIDENCE=0.5

# WhatsApp Cloud API, Qolca Solutions WABA (same values as condorin/.env.local).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ALERT_TEMPLATE=condorin_alerta
WA_CODE_TEMPLATE=condorin_codigo
WA_TEMPLATE_LANG=es
# Sending is on when WA_TOKEN is set. Uncomment to only log messages instead.
# WA_SEND_ENABLED=False

# Google Cloud Storage, read access to the detector buckets.
# Base64 of the service account JSON; it needs a private key to sign the evidence links.
GCS_CREDENTIALS_JSON=
GCS_PROJECT_ID=
GCS_SIGNED_URL_MINUTES=60

# Personal expediente links stay valid this many days.
ALERT_LINK_DAYS=60

# Email (Qolca SendGrid). Only the password (the SendGrid API key) is required.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Condorin <info@qolca.org>
